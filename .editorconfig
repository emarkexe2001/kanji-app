# Editor settings that match .prettierrc, for editors without a Prettier plugin
# and for files Prettier skips (e.g. Markdown).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

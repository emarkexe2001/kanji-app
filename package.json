{
  "name": "kanji-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @kanji/web",
    "build:web": "npm run build -w @kanji/web",

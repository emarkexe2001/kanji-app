    "test": "npm test -w @kanji/core",
    "data:build": "tsx scripts/build-deck.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "nextjs": "^0.0.3"
  }
}
